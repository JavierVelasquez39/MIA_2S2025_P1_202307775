digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.8];
  node [shape=record];
  bgcolor="#FFFFFF";

  subgraph cluster_carpetas {
    label="Bloques de Carpetas";
    bgcolor="#E3F2FD";
    bc_0 [shape=record, style=filled, fillcolor="#90CAF9", label="{Bloque 0|{.:0|..:0|users.txt:1|home:2}}"]; // bloque carpeta
    bc_2 [shape=record, style=filled, fillcolor="#90CAF9", label="{Bloque 2|{.:2|..:0|user1:3|user2:5}}"]; // bloque carpeta
    bc_7 [shape=record, style=filled, fillcolor="#90CAF9", label="{Bloque 7|{.:2|..:2|user3:7}}"]; // bloque carpeta
    bc_3 [shape=record, style=filled, fillcolor="#90CAF9", label="{Bloque 3|{.:3|..:2|archivo.txt:4}}"]; // bloque carpeta
    bc_5 [shape=record, style=filled, fillcolor="#90CAF9", label="{Bloque 5|{.:5|..:2|mediano.txt:6}}"]; // bloque carpeta
    bc_8 [shape=record, style=filled, fillcolor="#90CAF9", label="{Bloque 8|{.:7|..:2|grande.txt:8}}"]; // bloque carpeta
  }

  subgraph cluster_archivos {
    label="Bloques de Archivos";
    bgcolor="#E8F5E9";
    ba_4 [shape=record, style=filled, fillcolor="#A5D6A7", label="{Bloque 4|Hola...}"];
    ba_6 [shape=record, style=filled, fillcolor="#A5D6A7", label="{Bloque 6|202307775...}"];
    ba_9 [shape=record, style=filled, fillcolor="#A5D6A7", label="{Bloque 9|Mi nombre es...}"];
    ba_1 [shape=record, style=filled, fillcolor="#A5D6A7", label="{Bloque 1|1,G,root\n1,U...}"];
  }

}
